---
// Technical illustration of a drilled, ventilated brake disc with a caliper — generated, no external assets.
const C = 200;
const holes: Array<{ x: number; y: number; r: number }> = [];
const rings = [{ r: 118, n: 24, s: 3.4, off: 0 }, { r: 136, n: 24, s: 3.6, off: 7.5 }, { r: 154, n: 24, s: 3.8, off: 0 }, { r: 170, n: 24, s: 3.8, off: 7.5 }];
for (const ring of rings) {
  for (let i = 0; i < ring.n; i++) {
    const a = ((i * 360) / ring.n + ring.off) * (Math.PI / 180);
    holes.push({ x: +(C + ring.r * Math.cos(a)).toFixed(1), y: +(C + ring.r * Math.sin(a)).toFixed(1), r: ring.s });
  }
}
const slots: string[] = [];
for (let i = 0; i < 12; i++) {
  const a0 = ((i * 30 + 12) * Math.PI) / 180, a1 = a0 + 0.42;
  const r0 = 110, r1 = 178;
  slots.push(`M${(C + r0 * Math.cos(a0)).toFixed(1)} ${(C + r0 * Math.sin(a0)).toFixed(1)} Q ${(C + 150 * Math.cos(a0 + 0.12)).toFixed(1)} ${(C + 150 * Math.sin(a0 + 0.12)).toFixed(1)} ${(C + r1 * Math.cos(a1)).toFixed(1)} ${(C + r1 * Math.sin(a1)).toFixed(1)}`);
}
const bolts = Array.from({ length: 5 }, (_, i) => {
  const a = ((i * 72 - 90) * Math.PI) / 180;
  return { x: +(C + 46 * Math.cos(a)).toFixed(1), y: +(C + 46 * Math.sin(a)).toFixed(1) };
});
---
<div class="hero-art" aria-hidden="true">
  <svg class="rotor" viewBox="0 0 400 400">
    <defs>
      <radialGradient id="rg-disc" cx="42%" cy="38%" r="70%">
        <stop offset="0" stop-color="#9b9da3" /><stop offset=".45" stop-color="#6c6e74" /><stop offset=".8" stop-color="#45464b" /><stop offset="1" stop-color="#2a2a2f" />
      </radialGradient>
      <radialGradient id="rg-hat" cx="45%" cy="40%" r="70%">
        <stop offset="0" stop-color="#3a3a40" /><stop offset="1" stop-color="#151518" />
      </radialGradient>
      <linearGradient id="lg-sheen" x1="0" y1="0" x2="1" y2="1">
        <stop offset="0" stop-color="#fff" stop-opacity=".22" /><stop offset=".5" stop-color="#fff" stop-opacity="0" /><stop offset="1" stop-color="#fff" stop-opacity=".08" />
      </linearGradient>
    </defs>
    <circle cx="200" cy="200" r="190" fill="url(#rg-disc)" />
    <circle cx="200" cy="200" r="190" fill="none" stroke="#1b1b1f" stroke-width="3" />
    <circle cx="200" cy="200" r="182" fill="none" stroke="#fff" stroke-opacity=".08" stroke-width="1" />
    <g fill="none" stroke="#1d1d21" stroke-opacity=".55" stroke-width="2.2" stroke-linecap="round">{slots.map((d) => <path d={d} />)}</g>
    <g fill="#141417">{holes.map((h) => <circle cx={h.x} cy={h.y} r={h.r} />)}</g>
    <circle cx="200" cy="200" r="190" fill="url(#lg-sheen)" />
    <circle cx="200" cy="200" r="100" fill="url(#rg-hat)" stroke="#0e0e10" stroke-width="3" />
    <circle cx="200" cy="200" r="88" fill="none" stroke="#fff" stroke-opacity=".06" />
    <g fill="#0b0b0d" stroke="#55565c" stroke-width="1.2">{bolts.map((b) => <circle cx={b.x} cy={b.y} r="7" />)}</g>
    <circle cx="200" cy="200" r="26" fill="#0b0b0d" stroke="#55565c" stroke-width="1.5" />
  </svg>
  <svg class="caliper" viewBox="0 0 400 400">
    <defs>
      <linearGradient id="lg-cal" x1="0" y1="0" x2="1" y2="1">
        <stop offset="0" stop-color="#ff2a3d" /><stop offset=".5" stop-color="#d4001a" /><stop offset="1" stop-color="#8e0011" />
      </linearGradient>
    </defs>
    <path d="M318 92c34 14 58 52 62 96v24c-4 44-28 82-62 96-12 5-24-2-26-15l-6-38c-1-8 3-15 10-19 10-6 16-19 16-34v-28c0-15-6-28-16-34-7-4-11-11-10-19l6-38c2-13 14-20 26-15z" fill="url(#lg-cal)" />
    <path d="M318 92c34 14 58 52 62 96v24c-4 44-28 82-62 96" fill="none" stroke="#fff" stroke-opacity=".28" stroke-width="2" />
    <circle cx="330" cy="140" r="6" fill="#5a000a" /><circle cx="330" cy="260" r="6" fill="#5a000a" />
    <text x="350" y="200" fill="#fff" font-family="Barlow Condensed, Arial Narrow, sans-serif" font-weight="700" font-size="22" letter-spacing="5" text-anchor="middle" transform="rotate(90 350 200)">brembo</text>
  </svg>
  <div class="spec-tag"><b>PADS</b> · <b>DISCS</b> · <b>SENSORS</b> · <b>FLUID</b><br/>OE no. · Brembo no. · VIN check</div>
</div>
