---
import Icon from './Icon.astro';
import { lp, t } from '../lib/i18n.ts';
import type { Lang } from '../lib/catalog.ts';
interface Props { lang: Lang }
const { lang } = Astro.props;
---
<div class="scrim" data-scrim></div>
<aside class="drawer" id="cart-drawer" role="dialog" aria-modal="true" aria-labelledby="cart-title" data-cart-drawer>
  <div class="drawer-head">
    <h2 id="cart-title">{t(lang, 'cartTitle')}</h2>
    <button class="icon-btn" type="button" data-close-cart aria-label={t(lang, 'close')}><Icon name="close" /></button>
  </div>
  <div class="drawer-body" data-cart-lines>
    <div class="skeleton" style="height:64px;margin-top:14px"></div>
  </div>
  <div class="drawer-foot" data-cart-foot hidden>
    <div class="sum"><span>{t(lang, 'subtotal')}</span><b data-cart-subtotal></b></div>
    <div class="sum"><span>{t(lang, 'delivery')}</span><b data-cart-delivery></b></div>
    <div class="sum total"><span>{t(lang, 'total')}</span><b data-cart-total></b></div>
    <a class="btn btn-red btn-lg btn-block" href={lp(lang, '/checkout/')} style="margin-top:8px">{t(lang, 'checkout')}<Icon name="arrow" class="flip-rtl" /></a>
    <button class="btn btn-ghost btn-block" type="button" data-close-cart>{t(lang, 'continueShopping')}</button>
  </div>
</aside>
<div class="toasts" aria-live="polite" aria-atomic="false" data-toasts></div>
